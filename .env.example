# Atlas Environment Variables
# Copy this file to .env and fill in your values

# Port for the localhost server (default: dynamic)
# PORT=5500

# Startup timeout for the server in milliseconds (default: 30000)
# ATLAS_STARTUP_TIMEOUT=30000

# Remote debugging port for CDP connection (default: 0)
# ATLAS_DEBUG_PORT=9222

# Project name for display in the HUD
# ATLAS_PROJECT_NAME=My Project

# Domain to mask localhost as (e.g. annapurna.org)
# ATLAS_DOMAIN=localhost

# Disabled tabs (comma-separated, e.g. console,network)
# ATLAS_DISABLED_TABS=

# Authorized User Email (for PII leak filtering)
# ATLAS_USER_EMAIL=user@example.com

# Authorized Tokens (comma-separated, for PII leak filtering)
# ATLAS_AUTHORIZED_TOKENS=
