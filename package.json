{
  "name": "atlas-sandbox",
  "version": "1.0.1",
  "description": "Chrome-based local development sandbox with production domain masking,load stressor, and session recording",
  "main": "entry.js",
  "bin": {
    "atlas": "./atlas.cmd"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ui && tsc && (if not exist dist\\src\\electron\\assets mkdir dist\\src\\electron\\assets) && xcopy /E /I /Y src\\electron\\assets dist\\src\\electron\\assets && copy dist\\src\\electron\\preload.js dist\\electron\\preload.js && (if not exist dist\\gui mkdir dist\\gui) && copy dist\\src\\gui\\gui-renderer.js dist\\gui\\gui-renderer.js && copy src\\gui\\gui.css dist\\gui\\gui.css && copy src\\gui\\gui-host.html dist\\gui\\gui-host.html && copy src\\electron\\assets\\icon.png dist\\gui\\icon.png && copy node_modules\\mermaid\\dist\\mermaid.min.js dist\\gui\\mermaid.min.js && copy node_modules\\marked\\marked.min.js dist\\gui\\marked.min.js",
    "build:ui": "vite build",
    "lint": "eslint \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.atlas.sandbox",
    "productName": "Atlas-Sandbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "entry.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "atlas.cmd",
        "to": "."
      },
      {
        "from": "atlas",
        "to": "."
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "dist/src/electron/assets/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "keywords": [
    "development",
    "sandbox",
    "testing",
    "chrome",
    "puppeteer",
    "domain-masking",
    "load-stressor",
    "session-recording",
    "localhost",
    "devtools"
  ],
  "author": "Chirag Parmar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chirag-parmar16/atlas"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/ws": "^8.18.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "express": "^5.2.1",
    "inquirer": "^13.1.0",
    "marked": "^12.0.0",
    "mermaid": "^10.9.5",
    "puppeteer-core": "^24.34.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "tree-kill": "^1.2.2",
    "ws": "^8.19.0"
  }
}
